DEBUG=True
SECRET_KEY=replace-with-a-long-random-local-development-key
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Taipei

# Local SQLite is used when DATABASE_URL is omitted. On Render, use your
# EXISTING PostgreSQL database's Internal Database URL; never commit that URL.
# DATABASE_URL=postgresql://...

# Leave credentials unset until you are ready to enable real email delivery.
# Set EMAIL_HOST_USER and EMAIL_HOST_PASSWORD directly in Render.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=expiry-tracker@example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Optional: enable the GitHub Actions OIDC reminder endpoint. Configure all four
# non-secret trust settings from EMAIL-SCHEDULE.zh-TW.md for YOUR repository.
# REMINDER_OIDC_AUDIENCE=
# REMINDER_OIDC_REPOSITORY_ID=
# REMINDER_OIDC_OWNER_ID=
# REMINDER_OIDC_WORKFLOW_REF=

# Optional locally; required for persistent document uploads on Render.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
