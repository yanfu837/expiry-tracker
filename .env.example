DEBUG=True
SECRET_KEY=replace-with-a-long-random-local-development-key
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=UTC

# Local SQLite is used when DATABASE_URL is omitted. On Render, use your
# EXISTING PostgreSQL database's Internal Database URL; never commit that URL.
# DATABASE_URL=postgresql://...

# Development emails appear in the terminal. Production requires SMTP and
# a verified sender. Set EMAIL_HOST_USER and EMAIL_HOST_PASSWORD in Render.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=expiry-tracker@example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Optional locally; required for persistent document uploads on Render.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
